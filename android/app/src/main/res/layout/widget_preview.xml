<?xml version="1.0" encoding="utf-8"?>
<!--
  启动器渲染的静态预览（previewLayout）。这里**只用最基础的控件**：不引用样式、
  不用 Chronometer / 自定义 drawable，也不依赖运行时下发的数据。

  之前直接把真实的 widget_solar_time_compact 当预览，某些新 ROM（如 HyperOS 上的
  小米机型）在「将小部件添加到桌面?」弹窗里渲染它会失败，显示「载入窗口小部件时
  出现问题」——那个预览是启动器自己 inflate 的，跟 App 进程无关，运行时再兜底也救不了。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F01B2436"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:text="上海市黄浦区"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="标准时间"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="21:42"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="真太阳时"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="22:04"
                android:textColor="#FFFFC65C"
                android:textSize="30sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
