<?xml version="1.0" encoding="utf-8"?>
<!-- 由脚本生成：紧凑间距（2 行高，5x2 默认布局）：字号相同，留白压缩、逐时行放大以填满单元。改结构后请整份重新生成。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_night"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_civil_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_civil"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_city"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 标准时间交给 TextClock：宿主进程按整分/整秒自行走时，
                     既不依赖本 App 的刷新闹钟，也保证秒与分在同一时刻进位。 -->
                <TextClock
                    android:id="@+id/widget_civil_time"
                    style="@style/WidgetClockMain"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:text="00:00"
                    android:textColor="#FFFFFFFF"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/WidgetClockColon"
                    android:text=":"
                    tools:ignore="HardcodedText" />

                <TextClock
                    android:id="@+id/widget_civil_sec"
                    style="@style/WidgetClockSecondTicked"
                    android:format12Hour="ss"
                    android:format24Hour="ss"
                    android:text="00"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_civil_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:background="#33FFFFFF"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/widget_solar_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_solar"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_solar_shichen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_solar_time"
                    style="@style/WidgetClockMain"
                    android:text="00:00"
                    android:textColor="#FFFFC65C"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/widget_solar_colon"
                    style="@style/WidgetClockColonSolar"
                    android:text=":"
                    tools:ignore="HardcodedText" />

                <!--
                  秒数：Chronometer 自己每秒走一格，并且每次都按 base 重算到下一整秒的延时，
                  不会像翻页器那样越走越慢；宽度由 setMaxWidth 限成两位数字、右对齐，
                  于是只露出「0:SS」里的后两位。
                -->
                <Chronometer
                    android:id="@+id/widget_solar_sec"
                    style="@style/WidgetClockSecondChrono"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_coordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:background="#22FFFFFF" />

    <LinearLayout
        android:id="@+id/widget_hour_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_0"
                style="@style/WidgetHourLabelCompact" />
            <ImageView
                android:id="@+id/widget_hour_icon_0"
                style="@style/WidgetHourIconCompact" />
            <TextView
                android:id="@+id/widget_hour_cond_0"
                style="@style/WidgetHourCondCompact" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_1"
                style="@style/WidgetHourLabelCompact" />
            <ImageView
                android:id="@+id/widget_hour_icon_1"
                style="@style/WidgetHourIconCompact" />
            <TextView
                android:id="@+id/widget_hour_cond_1"
                style="@style/WidgetHourCondCompact" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_2"
                style="@style/WidgetHourLabelCompact" />
            <ImageView
                android:id="@+id/widget_hour_icon_2"
                style="@style/WidgetHourIconCompact" />
            <TextView
                android:id="@+id/widget_hour_cond_2"
                style="@style/WidgetHourCondCompact" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_3"
                style="@style/WidgetHourLabelCompact" />
            <ImageView
                android:id="@+id/widget_hour_icon_3"
                style="@style/WidgetHourIconCompact" />
            <TextView
                android:id="@+id/widget_hour_cond_3"
                style="@style/WidgetHourCondCompact" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_4"
                style="@style/WidgetHourLabelCompact" />
            <ImageView
                android:id="@+id/widget_hour_icon_4"
                style="@style/WidgetHourIconCompact" />
            <TextView
                android:id="@+id/widget_hour_cond_4"
                style="@style/WidgetHourCondCompact" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_5"
                style="@style/WidgetHourLabelCompact" />
            <ImageView
                android:id="@+id/widget_hour_icon_5"
                style="@style/WidgetHourIconCompact" />
            <TextView
                android:id="@+id/widget_hour_cond_5"
                style="@style/WidgetHourCondCompact" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
