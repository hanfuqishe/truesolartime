                <TextView style="@style/WidgetClockSecond" android:text="56" />
                <TextView style="@style/WidgetClockSecond" android:text="57" />
                <TextView style="@style/WidgetClockSecond" android:text="58" />
                <TextView style="@style/WidgetClockSecond" android:text="59" />
            </ViewFlipper>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_civil_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:background="#33FFFFFF"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_solar"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_solar_shichen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_solar_time"
                    style="@style/WidgetClockMain"
                    android:text="00:00"
                    android:textColor="#FFFFC65C"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/WidgetClockSecondSolar"
                    android:layout_marginBottom="5dp"
                    android:text=":"
                    tools:ignore="HardcodedText" />

            <ViewFlipper
                android:id="@+id/widget_solar_sec"
                android:layout_width="27sp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:autoStart="true"
                android:flipInterval="1000"
                tools:ignore="HardcodedText">
                <TextView style="@style/WidgetClockSecondSolar" android:text="00" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="01" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="02" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="03" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="04" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="05" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="06" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="07" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="08" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="09" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="10" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="11" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="12" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="13" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="14" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="15" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="16" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="17" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="18" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="19" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="20" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="21" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="22" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="23" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="24" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="25" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="26" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="27" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="28" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="29" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="30" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="31" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="32" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="33" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="34" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="35" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="36" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="37" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="38" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="39" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="40" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="41" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="42" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="43" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="44" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="45" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="46" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="47" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="48" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="49" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="50" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="51" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="52" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="53" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="54" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="55" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="56" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="57" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="58" />
                <TextView style="@style/WidgetClockSecondSolar" android:text="59" />
            </ViewFlipper>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_coordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:background="#22FFFFFF" />

    <LinearLayout
        android:id="@+id/widget_hour_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_hour_label_0"
                    style="@style/WidgetHourLabel" />
                <ImageView
                    android:id="@+id/widget_hour_icon_0"
                    style="@style/WidgetHourIcon" />
                <TextView
                    android:id="@+id/widget_hour_cond_0"
                    style="@style/WidgetHourCond" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_hour_label_1"
                    style="@style/WidgetHourLabel" />
                <ImageView
                    android:id="@+id/widget_hour_icon_1"
                    style="@style/WidgetHourIcon" />
                <TextView
                    android:id="@+id/widget_hour_cond_1"
                    style="@style/WidgetHourCond" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_hour_label_2"
                    style="@style/WidgetHourLabel" />
                <ImageView
                    android:id="@+id/widget_hour_icon_2"
                    style="@style/WidgetHourIcon" />
                <TextView
                    android:id="@+id/widget_hour_cond_2"
                    style="@style/WidgetHourCond" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_hour_label_3"
                    style="@style/WidgetHourLabel" />
                <ImageView
                    android:id="@+id/widget_hour_icon_3"
                    style="@style/WidgetHourIcon" />
                <TextView
                    android:id="@+id/widget_hour_cond_3"
                    style="@style/WidgetHourCond" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_hour_label_4"
                    style="@style/WidgetHourLabel" />
                <ImageView
                    android:id="@+id/widget_hour_icon_4"
                    style="@style/WidgetHourIcon" />
                <TextView
                    android:id="@+id/widget_hour_cond_4"
                    style="@style/WidgetHourCond" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_hour_label_5"
                    style="@style/WidgetHourLabel" />
                <ImageView
                    android:id="@+id/widget_hour_icon_5"
                    style="@style/WidgetHourIcon" />
                <TextView
                    android:id="@+id/widget_hour_cond_5"
                    style="@style/WidgetHourCond" />
            </LinearLayout>
    </LinearLayout>

</LinearLayout>
