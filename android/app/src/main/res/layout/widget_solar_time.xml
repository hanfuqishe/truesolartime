<?xml version="1.0" encoding="utf-8"?>
<!-- 由脚本生成：常规尺寸（3 行及以上）。改结构后请整份重新生成。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_night">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

    <!-- 地名超长时的整行显示：让出「标准时间」「真太阳时」两处标签的位置。
         放在内容列里（不是叠在 FrameLayout 顶部），这样它会跟着整块内容一起居中。 -->
    <TextView
        android:id="@+id/widget_city_wide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="克孜勒苏柯尔克孜自治州阿图什市" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_civil_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_label_civil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_civil"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_city"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 标准时间交给 TextClock：宿主进程按整分/整秒自行走时，
                     既不依赖本 App 的刷新闹钟，也保证秒与分在同一时刻进位。 -->
                <TextClock
                    android:id="@+id/widget_civil_time"
                    style="@style/WidgetClockMain"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:text="00:00"
                    android:textColor="#FFFFFFFF"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/WidgetClockColon"
                    android:text=":"
                    tools:ignore="HardcodedText" />

                <TextClock
                    android:id="@+id/widget_civil_sec"
                    style="@style/WidgetClockSecondTicked"
                    android:format12Hour="ss"
                    android:format24Hour="ss"
                    android:text="00"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_civil_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:background="#33FFFFFF"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/widget_solar_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_label_solar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_solar"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_solar_shichen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_solar_time"
                    style="@style/WidgetClockMain"
                    android:text="00:00"
                    android:textColor="#FFFFC65C"
                    tools:ignore="HardcodedText" />

                <!--
                  冒号与秒默认隐藏：桌面「添加小组件」的系统预览直接渲染这份布局，
                  此时还没有 base，Chronometer 会显示一段被裁掉的时间（看着像多出一个括号）。
                  真正刷新时由 WidgetUpdater 把它们设为可见。
                -->
                <TextView
                    android:id="@+id/widget_solar_colon"
                    style="@style/WidgetClockColonSolar"
                    android:text=":"
                    android:visibility="invisible"
                    tools:ignore="HardcodedText" />

                <!--
                  秒数：Chronometer 自己每秒走一格，并且每次都按 base 重算到下一整秒的延时，
                  不会像翻页器那样越走越慢；宽度由 setMaxWidth 限成两位数字、右对齐，
                  于是只露出「0:SS」里的后两位。
                -->
                <Chronometer
                    android:id="@+id/widget_solar_sec"
                    style="@style/WidgetClockSecondChrono"
                    android:visibility="invisible"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_coordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 真太阳时 0–24 时的时间轴：彩色段是「服用时间」，白点是当前时刻；位图由 WidgetAxis 绘制。 -->
    <ImageView
        android:id="@+id/widget_axis"
        android:layout_width="match_parent"
        android:layout_height="13dp"
        android:layout_marginTop="3dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/widget_hour_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_0"
                style="@style/WidgetHourLabel" />
            <ImageView
                android:id="@+id/widget_hour_icon_0"
                style="@style/WidgetHourIcon" />
            <TextView
                android:id="@+id/widget_hour_cond_0"
                style="@style/WidgetHourCond" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_1"
                style="@style/WidgetHourLabel" />
            <ImageView
                android:id="@+id/widget_hour_icon_1"
                style="@style/WidgetHourIcon" />
            <TextView
                android:id="@+id/widget_hour_cond_1"
                style="@style/WidgetHourCond" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_2"
                style="@style/WidgetHourLabel" />
            <ImageView
                android:id="@+id/widget_hour_icon_2"
                style="@style/WidgetHourIcon" />
            <TextView
                android:id="@+id/widget_hour_cond_2"
                style="@style/WidgetHourCond" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_3"
                style="@style/WidgetHourLabel" />
            <ImageView
                android:id="@+id/widget_hour_icon_3"
                style="@style/WidgetHourIcon" />
            <TextView
                android:id="@+id/widget_hour_cond_3"
                style="@style/WidgetHourCond" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_4"
                style="@style/WidgetHourLabel" />
            <ImageView
                android:id="@+id/widget_hour_icon_4"
                style="@style/WidgetHourIcon" />
            <TextView
                android:id="@+id/widget_hour_cond_4"
                style="@style/WidgetHourCond" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_hour_label_5"
                style="@style/WidgetHourLabel" />
            <ImageView
                android:id="@+id/widget_hour_icon_5"
                style="@style/WidgetHourIcon" />
            <TextView
                android:id="@+id/widget_hour_cond_5"
                style="@style/WidgetHourCond" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
</FrameLayout>

