<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ???????42sp???????????????????????? -->
    <style name="WidgetClockMain">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">42sp</item>
    </style>

    <style name="WidgetClockSecondSolar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">#FFFFC65C</item>
    </style>

    <!-- 标准时间与冒号：冒号与秒同样半高，底部留 5dp 与主时间对齐 -->
    <style name="WidgetClockColon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="WidgetClockColonSolar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">#FFFFC65C</item>
    </style>

    <!-- 由 TextClock 逐秒自走的秒数，垂直位置需与冒号一致 -->
    <style name="WidgetClockSecondTicked">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <!-- ????????????????????? -->
    <style name="WidgetHourLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#B3FFFFFF</item>
    </style>

    <style name="WidgetHourIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="WidgetHourCond">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">#D9FFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- ===== 紧凑间距版（5x2 等 2 行高的小尺寸）：字号不变，只压缩留白 ===== -->







    <style name="WidgetHourIconCompact">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="WidgetHourLabelCompact">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#B3FFFFFF</item>
    </style>

    <style name="WidgetHourCondCompact">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">#D9FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>


</resources>
