<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 主时钟的字号由 WidgetUpdater 按栏宽实测换算成 px 下发，这里的 42dp 只是布局预览
         与「最小版面」兜底用。小组件里所有字号都用 dp 而不是 sp：桌面单元格尺寸固定，
         sp 会跟着系统「字体大小」放大，一放大版面就被挤出格子。 -->
    <style name="WidgetClockMain">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">42dp</item>
    </style>

    <style name="WidgetClockSecondSolar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">23dp</item>
        <item name="android:textColor">#FFFFC65C</item>
    </style>

    <!--
      真太阳时秒数：Chronometer 每秒自走（按 base 重算延时，不累积漂移）。
      它的文本是「0:SS」，宽度在刷新时用 setMaxWidth 限成两位数字、配合右对齐，
      只露出秒数。字体必须是等宽的：等宽下「0:」与「00」同宽，切点才与字体缩放、
      密度无关；用比例字体时冒号比数字窄，宽度稍偏就会把冒号露出来（多出一个冒号）。
      这里写的 textSize 只是布局预览的初值，实际字号与宽度由 WidgetUpdater 按 px 下发。
    -->
    <style name="WidgetClockSecondChrono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">none</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">23dp</item>
        <item name="android:textColor">#FFFFC65C</item>
    </style>

    <!-- 标准时间与冒号：冒号与秒同样半高，底部留 5dp 与主时间对齐 -->
    <style name="WidgetClockColon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">23dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="WidgetClockColonSolar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">23dp</item>
        <item name="android:textColor">#FFFFC65C</item>
    </style>

    <!-- 由 TextClock 逐秒自走的秒数，垂直位置需与冒号一致 -->
    <style name="WidgetClockSecondTicked">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">23dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

