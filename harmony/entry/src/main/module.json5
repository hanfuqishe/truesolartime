{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "orientation": "portrait",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    // 桌面卡片暂时关掉入口：鸿蒙的 ArkTS 卡片做不到「分钟级自走」的非本地时间（TextClock 忽略
    // format/timeZoneOffset、卡片内禁用定时器、updateDuration 最小 30 分钟、互动卡片激活态只有
    // 3500ms），卡片上的真太阳时只能靠推送刷新，会滞后最多 30 分钟。
    // 代码（entryformability / widget / CardService）都还在，系统能力补齐后把下面这段 extensionAbility
    // 恢复回来就能重新开放：
    //
    // "extensionAbilities": [
    //   {
    //     "name": "SolarTimeFormAbility",
    //     "srcEntry": "./ets/entryformability/SolarTimeFormAbility.ets",
    //     "label": "$string:form_label",
    //     "description": "$string:form_desc",
    //     "type": "form",
    //     "metadata": [
    //       {
    //         "name": "ohos.extension.form",
    //         "resource": "$profile:form_config"
    //       }
    //     ]
    //   }
    // ],
    "extensionAbilities": [],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:reason_location",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:reason_location",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER"
      }
    ]
  }
}
