{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "orientation": "portrait",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    // 桌面卡片重新关掉入口（1.4.37 短暂开放后实测撤回）：鸿蒙的 ArkTS 卡片做不到「分钟级自走」的
    // 非本地时间，实测（HarmonyOS 6.0.0 / API 20）：
    //   - 卡片里的 TextClock 忽略 format()：写 HH:mm:ss 也只显示 HH:mm，拿不到秒；
    //   - TextClock.timeZoneOffset 生效，但只按整数小时位移（小数被截断），且符号与直觉相反
    //     （传 3 = 西三区，系统 10:15 时显示 23:15）；
    //   - 卡片内禁用定时器（setInterval 编译报 11706006、TextTimer 忽略 count）；
    //   - 刷新下限：updateDuration 30 分钟、setFormNextRefreshTime 5 分钟、互动卡片激活态 3.5 s。
    // 折中方案是「推送 + 5 分钟刷新链」，但卡片上的真太阳时最好也滞后 5 分钟，对时钟类应用是误导。
    // 代码（entryformability / widget / CardService）全部保留，系统补齐能力后把下面这段
    // extensionAbility 恢复回来、并把 CardService.CARD_ENTRY_ENABLED 改成 true 即可重新开放。
    //
    // "extensionAbilities": [
    //   {
    //     "name": "SolarTimeFormAbility",
    //     "srcEntry": "./ets/entryformability/SolarTimeFormAbility.ets",
    //     "label": "$string:form_label",
    //     "description": "$string:form_desc",
    //     "type": "form",
    //     "metadata": [
    //       {
    //         "name": "ohos.extension.form",
    //         "resource": "$profile:form_config"
    //       }
    //     ]
    //   }
    // ],
    "extensionAbilities": [],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:reason_location",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:reason_location",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER"
      }
    ]
  }
}
