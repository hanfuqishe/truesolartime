<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WeatherKit：App ID 上必须开启同名 capability，描述文件才会带上这个 entitlement。
	     目前**只做签名链路验证**，业务代码还没接 WeatherKit；若 Archive 因签名失败，
	     说明 App ID 的 capability 没同步到描述文件（见 ios/ci/asc.py 里的 ensure_weatherkit_capability）。 -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
