<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WeatherKit requires the capability to be enabled on the App ID
	     (developer.apple.com > Identifiers > com.realsuntime.solartime > WeatherKit).
	     The ASC API does not accept capabilityType=WEATHERKIT, so that step is manual:
	     POST /v1/bundleIdCapabilities returns 409 ENTITY_ERROR.ATTRIBUTE.TYPE.
	     Once enabled, the provisioning profile carries this entitlement automatically. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
